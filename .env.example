# Django Settings
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com,seu-ip-da-vps

# Banco PostgreSQL (container smarthive-postgres). Obrigatória no Docker.
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
# Pasta do host com os dados persistentes (banco + uploads). Fora de volumes do
# Docker de propósito: `docker compose down -v` não apaga. Padrão: ./dados
SMARTHIVE_DADOS=/root/smarthive-dados
# Porta HTTP do nginx no host (padrão 8080)
# SMARTHIVE_HTTP_PORT=8080
# Superusuário criado no primeiro deploy (deixe vazio depois de criado)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://seu-dominio.com

# Email Settings (opcional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha

# Frontend API URL (para build de produção)
VITE_API_URL=http://localhost:8080/api

# Câmera ao vivo — segredo compartilhado entre MediaMTX e Django.
# Os scripts de deploy geram automaticamente se estiver vazio.
MEDIAMTX_AUTH_SECRET=
# Duração máxima de uma sessão assistindo à câmera (minutos)
CAMERA_SESSAO_MAX_MINUTOS=30
